@charset "windows-1252";

html { height: 100%; }

body { background-color: rgb(35, 37, 39); color: rgb(255, 255, 255); font-family: "Builder Sans", "Source Sans Pro", sans-serif; height: auto; margin: 0px; min-width: 320px; text-align: center; overflow: hidden; background-image: url("https://images.rbxcdn.com/c5d9dc67ec813ea8e7e3616c68a34041-maintenance-v2.jpg"); background-repeat: no-repeat; background-size: cover; background-position: center center; }

body a { color: rgb(255, 255, 255); }

.content { position: relative; height: 100%; text-align: center; }

.container { width: 67.5%; max-width: 960px; min-width: 320px; height: 480px; margin: auto; position: absolute; inset: 0px; }

.header { position: absolute; width: 100%; }

.maintenance-logo { width: 244px; margin: 0px auto; padding: 48px; }

.maintenance-center-container { display: table; width: 100%; height: 100%; }

.maintenance-center { display: table-cell; vertical-align: middle; }

.maintenance-title { font-size: 36px; font-weight: 700; line-height: 1.2em; padding-bottom: 12px; }

.maintenance-subtitle { font-size: 16px; }

.maintenance-status { padding: 48px; position: absolute; bottom: 0px; right: 0px; left: 0px; }

.maintenance-footer { position: absolute; bottom: 0px; padding-bottom: 50px; width: 100%; text-align: center; }

